# Shopify Storefront API — from Shopify admin → Settings → Apps and sales channels
# → Develop apps → [app] → API credentials → Storefront API access token.
# The Storefront token is public-safe (read-only storefront + cart scope).
# Leave both empty to develop against mock.shop (no credentials needed).
NUXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NUXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Mux live streaming (server-only) — see docs/live-streaming.md.
# Webhook signing secret: Mux dashboard → Settings → Webhooks → the endpoint's
# "Signing Secret". Verifies that live/idle events really come from Mux.
NUXT_MUX_WEBHOOK_SECRET=
# Sanity token with Editor access (manage.sanity.io → API → Tokens): the
# webhook route flips the live page's "Live Now" with it. Never public.
NUXT_SANITY_WRITE_TOKEN=

# Klaviyo newsletter (server-only) — see docs/newsletter.md.
# Private API key with lists:write, profiles:write and subscriptions:write
# scopes: Klaviyo → Settings → API keys → Create Private API Key. Never public.
NUXT_KLAVIYO_PRIVATE_API_KEY=
# The list footer signups join: Klaviyo → Lists & Segments → the list →
# Settings → List ID (a short code like "AbC123").
NUXT_KLAVIYO_LIST_ID=

# Staging only: true sends X-Robots-Tag: noindex on every response, so search
# engines never index a non-production deploy. Leave unset in production.
NUXT_NOINDEX=

# Pre-launch / staging only: a password puts the whole site behind HTTP basic
# auth (browser login prompt). Leave the password unset in
# production. The Mux webhook route stays open. A build that sees a password
# skips page caching (ISR), which would otherwise serve pages past the gate.
NUXT_BASIC_AUTH_USER=balun
NUXT_BASIC_AUTH_PASSWORD=

# Publish webhook (server/api/revalidate.post.ts, docs/performance-caching.md):
# the secret Sanity signs webhooks with, and Vercel's ISR bypass token (32+
# random characters; set for builds too, since it's baked into the page cache
# config). With both set, edits re-render their pages on publish and pages
# stay cached for 10 minutes; without, pages refresh every 60s.
NUXT_SANITY_WEBHOOK_SECRET=
NUXT_ISR_BYPASS_TOKEN=

# Optional: serve the build's code, fonts and images from another host (a
# Cloudflare-proxied subdomain of the site), e.g. https://assets.example.com.
# Runtime only. See docs/performance-caching.md.
NUXT_APP_CDN_URL=

# Draft preview (server-only) — see docs/preview.md. A Viewer token
# (manage.sanity.io → API → Tokens) that lets ?preview=true pages render
# unpublished drafts. Set it in dev and on the password-gated staging deploy
# only — never production, where page caching would hide previews anyway.
NUXT_SANITY_PREVIEW_TOKEN=
