# Shopify Storefront API — from Shopify admin → Settings → Apps and sales channels
# → Develop apps → [app] → API credentials → Storefront API access token.
# The Storefront token is public-safe (read-only storefront + cart scope).
# Leave both empty to develop against mock.shop (no credentials needed).
NUXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NUXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Mux live streaming (server-only) — see docs/live-streaming.md.
# Webhook signing secret: Mux dashboard → Settings → Webhooks → the endpoint's
# "Signing Secret". Verifies that live/idle events really come from Mux.
NUXT_MUX_WEBHOOK_SECRET=
# Sanity token with Editor access (manage.sanity.io → API → Tokens): the
# webhook route flips the live page's "Live Now" with it. Never public.
NUXT_SANITY_WRITE_TOKEN=
